      <ReportItem port="80" svc_name="http" protocol="tcp" severity="1" pluginID="11229" pluginName="Web Server Information Disclosure via Server Header" pluginFamily="Web Servers">
        <description>The remote web server reveals its type and version in the Server response header.</description>
        <solution>Configure the server to omit or disguise version tokens in HTTP headers.</solution>
        <plugin_output>Server: Apache/2.4.41 (Ubuntu)</plugin_output>
